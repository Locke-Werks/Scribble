#include <windows.h>

// Declared first so Explorer uses it as the file icon for the executable.
IDI_APPICON ICON "../assets/scribble.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     SCRIBBLE_RC_VERSION
PRODUCTVERSION  SCRIBBLE_RC_VERSION
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Locke Werks"
            VALUE "FileDescription",  SCRIBBLE_RC_DESCRIPTION
            VALUE "FileVersion",      SCRIBBLE_RC_VERSION_STRING
            VALUE "InternalName",     SCRIBBLE_RC_INTERNAL_NAME
            VALUE "LegalCopyright",   "Locke Werks. Licensed under the GNU GPL v3."
            VALUE "OriginalFilename", SCRIBBLE_RC_ORIGINAL_NAME
            VALUE "ProductName",      "Scribble"
            VALUE "ProductVersion",   SCRIBBLE_RC_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
